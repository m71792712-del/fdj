# Copiez en .env.local (local) ou renseignez dans Vercel (Settings > Environment Variables). Jamais de secret dans Git.

# Projet Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL publique de CE site (http://localhost:3000 en local ; l'adresse Vercel en production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Variables SECRÈTES (serveur uniquement : pas de préfixe NEXT_PUBLIC_, jamais dans Git) ---
# Clé secrète « service_role » de Supabase : sert à vérifier les clés d'accès et à créer les comptes.
SUPABASE_SERVICE_ROLE_KEY=
# Texte secret de 24 caractères minimum (ex. 40 caractères aléatoires). Sert à fabriquer le mot de passe interne de chaque compte.
# Ne le changez plus une fois des comptes créés : les utilisateurs existants ne pourraient plus se connecter.
ACCOUNT_PASSWORD_SECRET=
# Domaine utilisé pour l'adresse interne de chaque compte (<numéro>@<domaine>). Aucun e-mail n'y est jamais envoyé.
# Si Supabase refuse l'adresse (« email address invalid »), mettez un domaine qui possède une adresse de messagerie réelle (ex. gmail.com, ou le vôtre).
ACCOUNT_EMAIL_DOMAIN=gmail.com
